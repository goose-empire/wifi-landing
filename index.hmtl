<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Wi-Fi Access Terms</title>

  <!-- Google Fonts: Martian Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Martian+Mono:wght@400;700;800&display=swap" rel="stylesheet">

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Martian Mono', monospace;
    }

    body {
      min-height: 100vh;
      width: 100vw;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      align-items: center;
      padding: 40px 24px 32px 24px;
      /* Background full-cover image */
      background: url('./pizza-hawaii.jpg') center center / cover no-repeat fixed;
    }

    /* Top/Middle White Terms Card */
    .card {
      background: #FFFFFF;
      width: 100%;
      max-width: 360px;
      border-radius: 24px;
      padding: 32px 24px;
      text-align: center;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
      margin-top: auto;
      margin-bottom: auto;
    }

    .card-title {
      color: #9C2A10;
      font-size: 14px;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
      margin-bottom: 28px;
    }

    /* Consent Checkbox Area */
    .consent-container {
      display: flex;
      align-items: center;
      gap: 16px;
      text-align: left;
      cursor: pointer;
      user-select: none;
    }

    /* Custom Checkbox Design matching screenshot */
    .custom-checkbox {
      position: relative;
      width: 48px;
      height: 48px;
      min-width: 48px;
      background-color: #A42A0D;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s ease;
    }

    /* Hide real checkbox input */
    .consent-container input[type="checkbox"] {
      position: absolute;
      opacity: 0;
      cursor: pointer;
      height: 0;
      width: 0;
    }

    /* Checkmark Icon */
    .checkmark {
      width: 24px;
      height: 24px;
      fill: none;
      stroke: #FFFFFF;
      stroke-width: 3.5;
      stroke-linecap: round;
      stroke-linejoin: round;
      opacity: 0;
      transform: scale(0.6);
      transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    /* Checked State styling */
    .consent-container input:checked ~ .custom-checkbox .checkmark {
      opacity: 1;
      transform: scale(1);
    }

    .consent-container input:not(:checked) ~ .custom-checkbox {
      background-color: #D6C2B8; /* Muted state before check */
    }

    .consent-text {
      color: #000000;
      font-size: 13px;
      font-weight: 800;
      line-height: 1.4;
      text-transform: uppercase;
    }

    /* Bottom Floating Button */
    .cta-btn {
      width: 100%;
      max-width: 360px;
      background-color: #F6E294;
      color: #9C2A10;
      border: none;
      border-radius: 18px;
      padding: 20px 16px;
      font-size: 15px;
      font-weight: 800;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      cursor: pointer;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
      transition: all 0.2s ease;
      opacity: 0.5;
      pointer-events: none;
    }

    .cta-btn.enabled {
      opacity: 1;
      pointer-events: auto;
      cursor: pointer;
    }

    .cta-btn.enabled:active {
      transform: scale(0.98);
    }

    /* Hidden credentials container revealed after tap */
    .wifi-reveal {
      display: none;
      margin-top: 20px;
      padding-top: 16px;
      border-top: 2px dashed #E5D5C5;
      text-align: center;
    }

    .wifi-reveal h4 {
      color: #9C2A10;
      margin-bottom: 8px;
    }

    .wifi-reveal code {
      background: #F4ECE1;
      padding: 4px 8px;
      border-radius: 6px;
      font-size: 14px;
      color: #000;
    }
  </style>
</head>
<body>

  <!-- Terms Card -->
  <div class="card">
    <div class="card-title">ACCEPT THE TERMS</div>

    <label class="consent-container" for="pizzaConsent">
      <input type="checkbox" id="pizzaConsent" onchange="toggleCTA()">
      <div class="custom-checkbox">
        <svg class="checkmark" viewBox="0 0 24 24">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </div>
      <span class="consent-text">
        I CONSENT THAT PIZZA HAWAII IS A DELICIOUS AND ACCEPTABLE PIECE OF FOOD
      </span>
    </label>

    <!-- Appears in card after clicking CTA -->
    <div id="wifiReveal" class="wifi-reveal">
      <h4>SSID: MyHomeNetwork</h4>
      <p>Password: <code>supersecret123</code></p>
    </div>
  </div>

  <!-- Bottom Action
